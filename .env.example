APP_NAME="Tandoor House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en_GB
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production; set false only for plain-http hosts.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Hosts allowed to open a socket (wildcards allowed); defaults to APP_URL's host.
# REVERB_ALLOWED_ORIGINS=tandoorhouse.co.uk,*.tandoorhouse.co.uk

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false

# Load balancer or CDN addresses in front of the app (comma-separated IPs or
# CIDRs, or * for the immediate hop). Empty trusts no proxy.
TRUSTED_PROXIES=

# --- Production -------------------------------------------------------------
# Uncomment and fill in on the live server; leave commented locally.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tandoorhouse.co.uk
# LOG_LEVEL=warning
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.your-provider.example
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="hello@tandoorhouse.co.uk"
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=10.0.0.0/8
# REVERB_HOST=ws.tandoorhouse.co.uk
# REVERB_PORT=443
# REVERB_SCHEME=https
# "null" sends nothing until a real SMS provider is bound; "log" writes to a file.
# NOTIFY_SMS_DRIVER=null
